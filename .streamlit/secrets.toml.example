# ============================================================
#  Streamlit secrets のひな形
#  ローカル: このファイルを .streamlit/secrets.toml にコピーして値を入れる
#  Cloud   : アプリの Settings → Secrets に同じ内容を貼り付ける
#  ※ secrets.toml は絶対にコミットしないこと（.gitignore 済み）
# ============================================================

# --- サービスアカウント（Sheets と Drive で共用）---
[gcp_service_account]
type = "service_account"
project_id = "your-project-id"
private_key_id = "xxxxxxxxxxxxxxxx"
private_key = "-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"
client_email = "oasis-bot@your-project-id.iam.gserviceaccount.com"
client_id = "1234567890"
auth_uri = "https://accounts.google.com/o/oauth2/auth"
token_uri = "https://oauth2.googleapis.com/token"
auth_provider_x509_cert_url = "https://www.googleapis.com/oauth2/v1/certs"
client_x509_cert_url = "https://www.googleapis.com/robot/v1/metadata/x509/oasis-bot%40your-project-id.iam.gserviceaccount.com"

# --- ベットログの保存先（Google スプレッドシート）---
[gsheets]
spreadsheet_id = "1AbCdEf...スプレッドシートURLの /d/ と /edit の間"
worksheet = "bet_log"

# --- 学習用レースログの取得元（Google ドライブ）---
[gdrive]
# フォルダごと読む場合（推奨）。URL でも ID でも可。
folder_id = "https://drive.google.com/drive/folders/1XxXxXx..."
pattern = ".txt"          # フォルダ内でこの文字を含む名前だけ読む
# 個別ファイルを指定したい場合はこちら（folder_id と併用可）
# file_ids = ["https://drive.google.com/file/d/1Yy.../view"]
